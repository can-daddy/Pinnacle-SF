/* Pinnacle-SF Global Theme Stylesheet */

/* Color Palette */
/* Primary: Deep Navy (#1A365D) */
/* Secondary: Soft Sky Blue (#EBF8FF) */
/* Accent: Muted Green (#48BB78) */
/* Warning: Muted Orange (#ED8936) */
/* Error: Soft Red (#F56565) */
/* Background: Off-white (#F7FAFC) */
/* Text: Near-black (#2D3748) */

/* ====== MAIN WINDOW AND BASIC WIDGETS ====== */

QMainWindow, QWidget {
    background-color: #F7FAFC;
    color: #2D3748;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 11px;
}

/* ====== LABELS - NO BORDERS ====== */

QLabel {
    color: #2D3748;
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}

QLabel.info {
    color: #3182CE;
    border: none;
    background: transparent;
}

QLabel.success {
    color: #38A169;
    border: none;
    background: transparent;
}

QLabel.warning {
    color: #ED8936;
    border: none;
    background: transparent;
}

QLabel.error {
    color: #E53E3E;
    border: none;
    background: transparent;
}

QLabel.pageTitle, QLabel#pageTitle {
    font-size: 24px;
    font-weight: bold;
    color: #1A365D;
    border: none;
    background: transparent;
}

QLabel.sectionTitle, QLabel#sectionTitle {
    font-size: 16px;
    font-weight: bold;
    color: #2D3748;
    margin-bottom: 10px;
    border: none;
    background: transparent;
}

QLabel.statusActive {
    color: #38A169;
    border: none;
    background: transparent;
}

QLabel.statusInactive {
    color: #ED8936;
    border: none;
    background: transparent;
}

QLabel.statusError {
    color: #E53E3E;
    border: none;
    background: transparent;
}

QFrame > QLabel {
    border: none;
    background: transparent;
}

/* ====== BUTTONS ====== */

QPushButton {
    background-color: #1A365D;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 5px;
    font-weight: bold;
    font-size: 12px;
    min-height: 28px;
    outline: none;
}

QPushButton:hover {
    background-color: #2D3748;
}

QPushButton:pressed {
    background-color: #1a2a3f;
}

QPushButton:disabled {
    background-color: #CBD5E0;
    color: #A0AEC0;
}

/* ====== SUCCESS BUTTON VARIANTS ====== */

QPushButton#successButton,
QPushButton.success,
QPushButton#largeSuccessButton {
    background-color: #48BB78;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 5px;
    font-weight: bold;
    font-size: 12px;
    min-height: 28px;
}

QPushButton#successButton:hover,
QPushButton.success:hover,
QPushButton#largeSuccessButton:hover {
    background-color: #38A169;
}

QPushButton#successButton:pressed,
QPushButton.success:pressed,
QPushButton#largeSuccessButton:pressed {
    background-color: #2F855A;
}

/* ====== DANGER BUTTON VARIANTS ====== */

QPushButton#dangerButton,
QPushButton.danger,
QPushButton#largeDangerButton {
    background-color: #F56565;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 5px;
    font-weight: bold;
    font-size: 12px;
    min-height: 28px;
}

QPushButton#dangerButton:hover,
QPushButton.danger:hover,
QPushButton#largeDangerButton:hover {
    background-color: #E53E3E;
}

QPushButton#dangerButton:pressed,
QPushButton.danger:pressed,
QPushButton#largeDangerButton:pressed {
    background-color: #C53030;
}

/* ====== WARNING BUTTON VARIANTS ====== */

QPushButton#warningButton,
QPushButton.warning {
    background-color: #ED8936;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 5px;
    font-weight: bold;
    font-size: 12px;
    min-height: 28px;
}

QPushButton#warningButton:hover,
QPushButton.warning:hover {
    background-color: #DD6B20;
}

QPushButton#warningButton:pressed,
QPushButton.warning:pressed {
    background-color: #C05621;
}

/* ====== INFO BUTTON VARIANTS ====== */

QPushButton#infoButton,
QPushButton.info {
    background-color: #3182CE;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 5px;
    font-weight: bold;
    font-size: 12px;
    min-height: 28px;
}

QPushButton#infoButton:hover,
QPushButton.info:hover {
    background-color: #2C5282;
}

QPushButton#infoButton:pressed,
QPushButton.info:pressed {
    background-color: #2B6CB0;
}

/* ====== LARGE BUTTON VARIANTS (EXPLICIT SIZING) ====== */

QPushButton#largeSuccessButton,
QPushButton#largeDangerButton {
    padding: 12px 24px;
    font-size: 14px;
    border-radius: 6px;
    min-height: 40px;
}

/* ====== TEXT INPUTS ====== */

QLineEdit, QTextEdit {
    background-color: #FFFFFF;
    color: #2D3748;
    border: 1px solid #E2E8F0;
    border-radius: 5px;
    padding: 8px;
    font-size: 11px;
}

QLineEdit:focus, QTextEdit:focus {
    border: 2px solid #1A365D;
    background-color: #FFFFFF;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #EDF2F7;
    color: #A0AEC0;
}

/* ====== COMBO BOX ====== */

QComboBox {
    background-color: #FFFFFF;
    color: #2D3748;
    border: 1px solid #E2E8F0;
    border-radius: 5px;
    padding: 6px 8px;
    min-height: 28px;
}

QComboBox:focus {
    border: 2px solid #1A365D;
}

QComboBox:disabled {
    background-color: #EDF2F7;
    color: #A0AEC0;
}

QComboBox::drop-down {
    border: none;
    width: 25px;
    background-color: transparent;
}

QComboBox::down-arrow {
    image: none;
    background: none;
}

/* CRITICAL: ComboBox dropdown list styling */
QComboBox QAbstractItemView {
    background-color: #FFFFFF !important;
    color: #2D3748 !important;
    border: 1px solid #E2E8F0 !important;
    border-radius: 5px;
    selection-background-color: #EBF8FF;
    selection-color: #1A365D;
    outline: none;
}

QComboBox QListView {
    background-color: #FFFFFF !important;
    color: #2D3748 !important;
    border: 1px solid #E2E8F0 !important;
    outline: none;
}

QComboBox QListView::item {
    background-color: #FFFFFF;
    color: #2D3748;
    padding: 5px;
}

QComboBox QListView::item:hover {
    background-color: #EBF8FF;
    color: #1A365D;
}

QComboBox QListView::item:selected {
    background-color: #EBF8FF;
    color: #1A365D;
}

/* ====== TABLE WIDGET ====== */

QTableWidget, QTableView {
    background-color: #FFFFFF;
    color: #2D3748;
    border: 1px solid #E2E8F0;
    border-radius: 5px;
    gridline-color: #E2E8F0;
    alternate-background-color: #F7FAFC;
}

QTableWidget::item, QTableView::item {
    padding: 8px;
    selection-background-color: #EBF8FF;
    selection-color: #1A365D;
}

QHeaderView::section {
    background-color: #1A365D;
    color: white;
    padding: 8px;
    border: none;
    font-weight: bold;
    font-size: 11px;
}

QHeaderView::section:hover {
    background-color: #2D3748;
}

QTableWidget QScrollBar:vertical, QTableView QScrollBar:vertical {
    width: 12px;
    background-color: #F7FAFC;
}

QTableWidget QScrollBar::handle:vertical, QTableView QScrollBar::handle:vertical {
    background-color: #CBD5E0;
    border-radius: 6px;
    min-height: 20px;
}

QTableWidget QScrollBar::handle:vertical:hover, QTableView QScrollBar::handle:vertical:hover {
    background-color: #A0AEC0;
}

/* ====== TAB WIDGET ====== */

QTabWidget::pane {
    border: 1px solid #E2E8F0;
    background-color: #F7FAFC;
    border-radius: 5px;
}

QTabBar {
    background-color: #F7FAFC;
    border-bottom: 2px solid #E2E8F0;
}

QTabBar::tab {
    background-color: #EDF2F7;
    color: #2D3748;
    border: 1px solid #E2E8F0;
    padding: 10px 20px;
    margin-right: 2px;
    border-radius: 5px 5px 0px 0px;
    font-weight: normal;
}

QTabBar::tab:hover {
    background-color: #E2E8F0;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    border-bottom: 3px solid #1A365D;
    color: #1A365D;
    font-weight: bold;
}

/* ====== DIALOG ====== */

QDialog, QFileDialog, QFontDialog, QColorDialog {
    background-color: #F7FAFC;
    color: #2D3748;
}

/* ====== FRAMES ====== */

QFrame {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 5px;
}

QFrame#headerFrame {
    background-color: #F7FAFC;
    border: none;
    border-bottom: 2px solid #E2E8F0;
}

QFrame#cardFrame {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 15px;
}

QFrame#summaryCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 20px;
}

QFrame.summaryCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 20px;
}

QFrame#summaryCard QLabel,
QFrame.summaryCard QLabel {
    color: #718096;
    font-size: 12px;
    border: none;
    background: transparent;
}

QFrame#summaryCard QLabel.value,
QFrame.summaryCard QLabel.value {
    color: #1A365D;
    font-weight: bold;
    font-size: 18px;
    border: none;
    background: transparent;
}

/* ====== SCROLL BAR - WITH PROPER VISIBILITY ====== */

QScrollBar:vertical {
    width: 12px;
    background-color: #F7FAFC;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background-color: #CBD5E0;
    border-radius: 6px;
    min-height: 20px;
    margin: 2px 2px 2px 2px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background-color: #F7FAFC;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    height: 12px;
    background-color: #F7FAFC;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:horizontal {
    background-color: #CBD5E0;
    border-radius: 6px;
    min-width: 20px;
    margin: 2px 2px 2px 2px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background-color: #F7FAFC;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* ====== SCROLL AREA ====== */

QScrollArea {
    background-color: #F7FAFC;
    border: none;
    show-decoration-selected: 1;
}

QAbstractScrollArea {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 5px;
}

QScrollArea > QWidget > QWidget {
    background-color: #F7FAFC;
}

/* ====== SPIN BOX ====== */

QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    color: #2D3748;
    border: 1px solid #E2E8F0;
    border-radius: 5px;
    padding: 5px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #1A365D;
}

/* ====== DATE AND TIME EDIT WIDGETS ====== */

QDateEdit, QDateTimeEdit, QTimeEdit {
    background-color: #FFFFFF;
    color: #2D3748;
    border: 1px solid #E2E8F0;
    border-radius: 5px;
    padding: 6px 8px;
    min-height: 28px;
    selection-background-color: #1A365D;
    selection-color: #FFFFFF;
}

QDateEdit:focus, QDateTimeEdit:focus, QTimeEdit:focus {
    border: 2px solid #1A365D;
    background-color: #FFFFFF;
}

QDateEdit:disabled, QDateTimeEdit:disabled, QTimeEdit:disabled {
    background-color: #EDF2F7;
    color: #A0AEC0;
}

QDateEdit::down-arrow, QDateTimeEdit::down-arrow {
    image: none;
    background-color: transparent;
}

QDateEdit::drop-down, QDateTimeEdit::drop-down {
    border: none;
    width: 20px;
}

/* ====== CALENDAR WIDGET ====== */

QCalendarWidget {
    background-color: #FFFFFF;
    color: #2D3748;
    border: 1px solid #E2E8F0;
    border-radius: 5px;
}

QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    color: #2D3748;
    border: none;
    selection-background-color: #1A365D;
    selection-color: #FFFFFF;
}

QCalendarWidget QWidget {
    background-color: #FFFFFF;
    color: #2D3748;
}

QCalendarWidget QToolButton {
    background-color: #F7FAFC;
    color: #2D3748;
    border: 1px solid #E2E8F0;
    padding: 4px;
    margin: 2px;
    border-radius: 3px;
}

QCalendarWidget QToolButton:hover {
    background-color: #EBF8FF;
}

QCalendarWidget QToolButton:pressed {
    background-color: #1A365D;
    color: #FFFFFF;
}

QCalendarWidget QMenu {
    background-color: #FFFFFF;
    color: #2D3748;
    border: 1px solid #E2E8F0;
}

QCalendarWidget QMenu::item:selected {
    background-color: #EBF8FF;
    color: #1A365D;
}

/* ====== CHECKBOX AND RADIO BUTTON ====== */

QCheckBox, QRadioButton {
    color: #2D3748;
    spacing: 5px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #FFFFFF;
    border: 1px solid #CBD5E0;
    border-radius: 3px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid #1A365D;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #1A365D;
    border: 1px solid #1A365D;
}

/* ====== MESSAGE BOX ====== */

QMessageBox {
    background-color: #F7FAFC;
}

QMessageBox QLabel {
    background-color: transparent;
    color: #2D3748;
    border: none;
}

QMessageBox QFrame {
    background-color: #F7FAFC;
    border: none;
}

QMessageBox QDialogButtonBox {
    background-color: #F7FAFC;
    button-layout: 0;
}

QMessageBox QPushButton {
    min-width: 80px;
    min-height: 32px;
    background-color: #1A365D;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 8px 16px;
    font-weight: bold;
}

QMessageBox QPushButton:hover {
    background-color: #2D3748;
}

/* ====== MENU AND MENU BAR ====== */

QMenuBar {
    background-color: #F7FAFC;
    color: #2D3748;
    border-bottom: 1px solid #E2E8F0;
}

QMenuBar::item:selected {
    background-color: #EBF8FF;
}

QMenu {
    background-color: #FFFFFF;
    color: #2D3748;
    border: 1px solid #E2E8F0;
    border-radius: 5px;
}

QMenu::item:selected {
    background-color: #EBF8FF;
    color: #1A365D;
}

QMenu::separator {
    height: 1px;
    background-color: #E2E8F0;
    margin: 5px 0px;
}

/* ====== GROUP BOX ====== */

QGroupBox {
    color: #2D3748;
    border: 2px solid #E2E8F0;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #1A365D;
    font-weight: bold;
}

/* ====== PROGRESS BAR ====== */

QProgressBar {
    background-color: #EDF2F7;
    border: 1px solid #E2E8F0;
    border-radius: 5px;
    height: 24px;
    text-align: center;
    color: #2D3748;
}

QProgressBar::chunk {
    background-color: #1A365D;
    border-radius: 5px;
}

/* ====== WIZARD BUTTONS ====== */

QWizard QPushButton {
    min-width: 80px;
    min-height: 32px;
}

/* ====== DIALOG BUTTONS ====== */

QDialog QPushButton,
QFileDialog QPushButton {
    background-color: #1A365D;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 5px;
    font-weight: bold;
    min-height: 28px;
}

QDialog QPushButton:hover,
QFileDialog QPushButton:hover {
    background-color: #2D3748;
}

/* ====== STATUS BAR ====== */

QStatusBar {
    background-color: #F7FAFC;
    color: #2D3748;
    border-top: 1px solid #E2E8F0;
}

QStatusBar::item {
    border: none;
    background-color: transparent;
}
